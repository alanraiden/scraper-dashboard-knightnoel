# Force LF line endings for shell scripts — prevents #!/bin/bash\r shebang errors on Linux
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf

# Windows-specific files keep CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
