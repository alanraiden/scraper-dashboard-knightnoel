[Unit]
Description=Knight Novel Scraper Server (24/7 watcher)
After=network.target

[Service]
Type=simple
User=iden
WorkingDirectory=/home/iden/scraper-dashboard-knightnoel/scraper-server
ExecStart=/usr/bin/python3 /home/iden/scraper-dashboard-knightnoel/scraper-server/scraper_server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Prevent the service from eating too much memory
MemoryMax=512M

[Install]
WantedBy=multi-user.target
